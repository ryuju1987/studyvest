# StudyVest local-first configuration
# Copy to .env for personal use. Never commit .env.

STUDYVEST_PORT=8787
# Default storage is ~/.studyvest-data. Keep this outside git.
# STUDYVEST_DATA_DIR=/Users/yourname/.studyvest-data

# SEC EDGAR does not require an API key, but it requires a descriptive User-Agent.
SEC_USER_AGENT="StudyVest/0.1 your-email-or-github-noreply@example.com"

# Rates / macro. Required for /api/fred/series.
FRED_API_KEY=

# US equities / ETFs via Alpaca market data. Keep read-only/data usage first.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex

# US equities/options via Tradier. Use sandbox first.
TRADIER_TOKEN=
TRADIER_ENV=sandbox

# Korea disclosures via OpenDART.
OPENDART_API_KEY=

# FX / commodities / backup quotes.
ALPHA_VANTAGE_API_KEY=
